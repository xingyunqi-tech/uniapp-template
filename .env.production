# 生产环境配置

# API 基础地址（小程序端必须为完整地址）
VITE_API_BASE_URL = 'https://api.sunweijie.top'

# 错误上报地址（留空则不上报）
VITE_ERROR_REPORT_URL = ''

# 微信订阅消息模板 ID：支付成功（需与后端 WECHAT_SUBSCRIBE_ORDER_PAID_TEMPLATE_ID 一致，留空则不申请）
VITE_WX_TMPL_ORDER_PAID = ''

# H5 是否额外产出 legacy 包兼容老机型（'true' 启用），目标浏览器读 .browserslistrc
VITE_LEGACY = 'true'
