{
  "name": "uniapp-template",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:app": "uni build -p app",
    "mp:upload:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin upload",
    "mp:upload:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay upload",
    "mp:preview:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin preview",
    "mp:preview:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "pnpm lint:script && pnpm lint:style",
    "lint:script": "eslint . --fix",
    "lint:style": "stylelint '**/*.{css,scss,vue}' --fix",
    "format": "prettier . --write",
    "api:gen": "orval",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist unpackage",
    "commit": "czg",
    "cspell": "cspell",
    "prepare": "npx husky"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "pnpm lint:script"
    ],
    "**/*.{css,scss,vue}": [
      "pnpm lint:style"
    ],
    "*": [
      "pretty-quick --staged"
    ]
  },
  "dependencies": {
    "@alova/adapter-uniapp": "^2.0.15",
    "@dcloudio/uni-app": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-components": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-h5": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-ui": "^1.5.11",
    "alova": "^3.5.0",
    "core-js": "^3.48.0",
    "lodash-es": "^4.17.23",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ts-md5": "^2.0.1",
    "vue": "^3.5.27",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@dcloudio/types": "^3.4.29",
    "@dcloudio/uni-automator": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5000120260205002",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5000120260205002",
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.2",
    "@uni-helper/uni-app-types": "^1.0.0-alpha.7",
    "@uni-helper/uni-ui-types": "^1.0.0-alpha.7",
    "@uni-helper/vite-plugin-uni-layouts": "^0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "^0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "^0.3.23",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/runtime-core": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "chalk": "^5.6.2",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "cspell": "^9.6.4",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "inquirer": "^13.2.2",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "minidev": "^2.2.5",
    "miniprogram-api-typings": "^5.0.0",
    "miniprogram-ci": "^2.1.26",
    "openapi3-ts": "^4.5.0",
    "orval": "^8.2.0",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "sass": "^1.97.3",
    "stylelint": "^17.1.1",
    "stylelint-config-property-sort-order-smacss": "^11.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  }
}
