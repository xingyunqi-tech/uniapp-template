{
  "name": "uniapp-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 22.22.2",
    "pnpm": ">= 11"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:app": "uni build -p app",
    "analyzer": "cross-env VITE_ENABLE_ANALYZER=true pnpm build:h5",
    "mp:upload:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin upload",
    "mp:upload:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay upload",
    "mp:preview:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin preview",
    "mp:preview:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay preview",
    "type-check": "pnpm type-check:app && pnpm type-check:node && pnpm type-check:test",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "pnpm lint:script && pnpm lint:style && pnpm lint:md",
    "lint:check": "eslint . --no-error-on-unmatched-pattern && stylelint '**/*.{css,scss,vue}' && markdownlint-cli2",
    "lint:script": "eslint . --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint '**/*.{css,scss,vue}' --fix",
    "lint:md": "markdownlint-cli2",
    "checkCssVars": "tsx scripts/cssVars/checkCssVars.ts",
    "screenshot": "tsx scripts/screenshot/index.ts",
    "format": "prettier . --write",
    "api:gen": "orval",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist unpackage",
    "commit": "czg",
    "cspell": "cspell",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --no-warn-ignored",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx|*.vue|*.css|*.scss)": [
      "prettier --write --ignore-unknown"
    ],
    "{src,tests,scripts}/**/*.{js,mjs,jsx,ts,tsx,vue}": [
      "cspell --no-must-find-files --no-progress"
    ]
  },
  "dependencies": {
    "@alova/adapter-uniapp": "^2.0.18",
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-ui": "^1.5.12",
    "alova": "^3.5.5",
    "core-js": "^3.50.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ts-md5": "^2.0.1",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/format": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030120260930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@uni-helper/uni-app-types": "^1.3.0",
    "@uni-helper/uni-ui-types": "^1.3.0",
    "@uni-helper/vite-plugin-uni-manifest": "^0.6.0",
    "@uni-helper/vite-plugin-uni-pages": "^0.5.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "chalk": "^6.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.1.0",
    "cspell": "^10.3.6",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "minidev": "^2.2.5",
    "miniprogram-api-typings": "^5.2.3",
    "openapi3-ts": "^4.6.1",
    "orval": "^8.40.0",
    "playwright": "1.64.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
