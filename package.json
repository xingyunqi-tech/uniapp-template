{
  "name": "uniapp-template",
  "version": "1.0.0",
  "engines": {
    "node": ">= 22.18",
    "pnpm": ">= 11"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:app": "uni build -p app",
    "mp:upload:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin upload",
    "mp:upload:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay upload",
    "mp:preview:weixin": "pnpm build:mp-weixin && pnpm tsx scripts/mp-upload.ts weixin preview",
    "mp:preview:alipay": "pnpm build:mp-alipay && pnpm tsx scripts/mp-upload.ts alipay preview",
    "type-check": "pnpm type-check:app && pnpm type-check:node && pnpm type-check:test",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "pnpm lint:script && pnpm lint:style && pnpm lint:md",
    "lint:check": "eslint . --no-error-on-unmatched-pattern && stylelint '**/*.{css,scss,vue}' && markdownlint-cli2",
    "lint:script": "eslint . --no-error-on-unmatched-pattern --fix",
    "lint:style": "stylelint '**/*.{css,scss,vue}' --fix",
    "lint:md": "markdownlint-cli2",
    "format": "prettier . --write",
    "api:gen": "orval",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist unpackage",
    "commit": "czg",
    "cspell": "cspell",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --no-warn-ignored",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx|*.vue|*.css|*.scss)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@alova/adapter-uniapp": "^2.0.15",
    "@dcloudio/uni-app": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-components": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-h5": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-ui": "^1.5.11",
    "alova": "^3.5.0",
    "core-js": "^3.48.0",
    "lodash-es": "^4.17.23",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ts-md5": "^2.0.1",
    "vue": "^3.5.27",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@commitlint/format": "^20.4.0",
    "@commitlint/types": "^20.4.0",
    "@dcloudio/types": "^3.4.29",
    "@dcloudio/uni-automator": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5000120260205002",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5000120260205002",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5000120260205002",
    "@eslint/js": "^10.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.2",
    "@uni-helper/uni-app-types": "^1.0.0-alpha.7",
    "@uni-helper/uni-ui-types": "^1.0.0-alpha.7",
    "@uni-helper/vite-plugin-uni-layouts": "^0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "^0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "^0.3.23",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "chalk": "^5.6.2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cspell": "^9.6.4",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.23.3",
    "minidev": "^2.2.5",
    "miniprogram-api-typings": "^5.0.0",
    "miniprogram-ci": "^2.1.26",
    "openapi3-ts": "^4.5.0",
    "orval": "^8.2.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "sass": "^1.97.3",
    "stylelint": "^17.1.1",
    "stylelint-config-property-sort-order-smacss": "^11.1.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
