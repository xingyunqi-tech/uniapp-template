{
  "name": "uniapp-template",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:app": "uni -p app",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit",
    "lint": "pnpm lint:script && pnpm lint:style",
    "lint:script": "eslint . --fix",
    "lint:style": "stylelint '**/*.{css,scss,vue}' --fix",
    "format": "prettier . --write",
    "api:gen": "orval",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist unpackage",
    "prepare": "husky",
    "commit": "czg"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "pnpm lint:script"
    ],
    "**/*.{css,scss,vue}": [
      "pnpm lint:style"
    ],
    "*": [
      "pretty-quick --staged"
    ]
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-components": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-h5": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-4080420251023001",
    "@dcloudio/uni-ui": "^1.5.11",
    "core-js": "^3.47.0",
    "vue": "^3.5.25",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "luch-request": "^3.1.1",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.19",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-4080420251023001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-4080420251023001",
    "@uni-helper/uni-app-types": "^1.0.0-alpha.7",
    "@uni-helper/uni-ui-types": "^1.0.0-alpha.7",
    "@uni-helper/vite-plugin-uni-pages": "^0.2.10",
    "@uni-helper/vite-plugin-uni-layouts": "^0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "^0.2.6",
    "miniprogram-api-typings": "^3.12.3",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vue-tsc": "^2.2.10",
    "sass": "^1.89.0",
    "unocss": "^66.1.1",
    "unocss-preset-uni": "^0.1.9",
    "@iconify-json/carbon": "^1.2.8",
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.1.0",
    "typescript-eslint": "^8.32.1",
    "vue-eslint-parser": "^10.1.3",
    "globals": "^16.2.0",
    "stylelint": "^16.19.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.0",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "vitest": "^3.2.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "orval": "^7.9.0",
    "openapi3-ts": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.1",
    "czg": "^1.11.1",
    "tsx": "^4.19.4",
    "chalk": "^5.4.1",
    "inquirer": "^12.6.0",
    "rimraf": "^6.0.1",
    "cross-env": "^7.0.3"
  }
}
