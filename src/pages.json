          }
        },
        {
          "path": "profile/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "编辑资料"
          }
        },
        {
          "path": "settings/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "设置"
          }
        }
      ]
    },
    {
      "root": "pages-sub/other",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-ALIPAY || MP-WEIXIN
        {
          "path": "about/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        },
        {
          "path": "component-demo/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "组件演示"
          }
        },
        {
          "path": "contact/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "联系客服"
          }
        },
        {
          "path": "feedback/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "意见反馈"
          }
        },
        {
          "path": "webview/index",
