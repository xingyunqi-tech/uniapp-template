{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^U(.*)": "@/components/U$1/index.vue",
      "^AuthLayout$": "@/components/AuthLayout/index.vue"
    }
  },
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "pages-sub/exam"
      ]
    },
    "pages/mine/index": {
      "network": "all",
      "packages": [
        "pages-sub/user",
        "pages-sub/order"
      ]
    },
    "pages-sub/user/settings/index": {
      "network": "all",
      "packages": [
        "pages-sub/other"
      ]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "UniApp",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index"
      },
      {
        "name": "登录",
        "path": "pages/login/index"
      },
      {
        "name": "注册",
        "path": "pages/register/index"
      },
      {
        "name": "我的",
        "path": "pages/mine/index"
      }
    ]
  },
  "pages": [
    // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-ALIPAY || MP-WEIXIN
    {
      "path": "pages/index/index",
      "type": "home",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/agreement/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "协议详情"
      }
    },
    {
      "path": "pages/ai/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "AI 助教"
      }
    },
    {
      "path": "pages/bank/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "题库",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/error/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "页面不存在"
      }
    },
    {
      "path": "pages/forgot-password/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "忘记密码",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/mine/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/register/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "注册",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/consent/index",
      "type": "page",
      "style": {
        "navigationBarTitleText": "用户协议与隐私政策",
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-sub/order",
      "pages": [
        // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-ALIPAY || MP-WEIXIN
        {
          "path": "detail/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "订单详情"
          }
        },
        {
          "path": "list/index",
          "type": "page",
          "style": {
            "navigationBarTitleText": "我的订单"
          }
        },
        {
          "path": "payment-result/index",
          "type": "page",
          "style": {
