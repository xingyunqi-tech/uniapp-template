{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "minWordLength": 3,
  "files": ["src/**/*.{js,ts,jsx,tsx,vue}", "tests/**/*.{js,ts,vue}", "scripts/**/*.{js,ts,mjs}"],
  "dictionaries": ["typescript", "node", "npm", "html", "css", "fonts", "softwareTerms"],
  "words": [
    "acmrd",
    "agreeprivacyauthorization",
    "alova",
    "bei",
    "cdp",
    "chatbubble",
    "checkin",
    "checkins",
    "checkmarkempty",
    "ches",
    "chooseavatar",
    "closeempty",
    "competitionid",
    "datamatrix",
    "daterange",
    "dcloudio",
    "descs",
    "dividline",
    "Dto",
    "easycom",
    "easyinput",
    "favorited",
    "gcj",
    "getmore",
    "getphonenumber",
    "hsl",
    "idcard",
    "ies",
    "itemclick",
    "jing",
    "jsapi",
    "jssdk",
    "launchapp",
    "loadmore",
    "localdata",
    "mediatype",
    "micromessenger",
    "minidev",
    "miniprogram",
    "mts",
    "mweb",
    "nicknamereview",
    "nomore",
    "noticebar",
    "opensetting",
    "paperplane",
    "persistedstate",
    "pickerview",
    "plusempty",
    "prepayid",
    "qqmap",
    "qrcode",
    "refreshempty",
    "refresherrefresh",
    "relogin",
    "rpx",
    "scrolltolower",
    "scrolltoupper",
    "seg",
    "sfc",
    "sunweijie",
    "toutiao",
    "uniapp",
    "unstub",
    "upx",
    "wechat",
    "weixin",
    "werun",
    "wgs",
    "wxml",
    "wxpay",
    "wxss",
    "yxxx"
  ],
  "patterns": [
    {
      "name": "jwt-token",
      "pattern": "/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/g"
    },
    {
      "name": "css-var",
      "pattern": "/--[a-zA-Z][a-zA-Z0-9-]*/g"
    },
    {
      "name": "import-path",
      "pattern": "/@\\/[a-zA-Z0-9/-]+/g"
    },
    {
      "name": "url-encoded",
      "pattern": "/%[0-9A-Fa-f]{2}/g"
    }
  ],
  "ignoreRegExpList": ["jwt-token", "css-var", "import-path", "url-encoded"],
  "ignorePaths": ["src/api/generated/**", "src/uni_modules/mp-html/**", "coverage/**", "dist/**"]
}
