{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "minWordLength": 3,
  "files": ["src/**/*.{js,ts,jsx,tsx,vue}"],
  "dictionaries": ["typescript", "node", "npm", "html", "css", "fonts", "softwareTerms"],
  "words": [
    "alova",
    "alipay",
    "aliyun",
    "appid",
    "composables",
    "datamatrix",
    "dcloudio",
    "Dto",
    "easycom",
    "easyinput",
    "favorited",
    "gcj",
    "getphonenumber",
    "husky",
    "jsapi",
    "jssdk",
    "loadmore",
    "localdata",
    "mediatype",
    "minidev",
    "miniprogram",
    "mutator",
    "mweb",
    "nomore",
    "noticebar",
    "openapi",
    "openid",
    "openspec",
    "orval",
    "persistedstate",
    "pinia",
    "qqmap",
    "qrcode",
    "rpx",
    "safearea",
    "scrolltolower",
    "Segoe",
    "Songti",
    "stacktracey",
    "statusbar",
    "tabbar",
    "toutiao",
    "TTFB",
    "uniapp",
    "unionpay",
    "unocss",
    "unplugin",
    "vant",
    "vite",
    "vitest",
    "wechat",
    "weixin",
    "werun",
    "wgs",
    "wxpay"
  ],
  "patterns": [
    {
      "name": "jwt-token",
      "pattern": "/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/g"
    },
    {
      "name": "css-var",
      "pattern": "/--[a-zA-Z][a-zA-Z0-9-]*/g"
    },
    {
      "name": "import-path",
      "pattern": "/@\\/[a-zA-Z0-9/-]+/g"
    },
    {
      "name": "uni-events",
      "pattern": "/(?:refresherrefresh|checkmarkempty|closeempty|dividline|itemclick)/g"
    }
  ],
  "ignoreRegExpList": ["jwt-token", "css-var", "import-path", "uni-events"],
  "ignorePaths": ["src/api/generated/**", "src/api/openapi.json"]
}
